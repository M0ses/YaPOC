#!/usr/bin/env python3
"""Pre-receive hook implemented with subprocess shell calls to git log."""

from __future__ import annotations

import re
import subprocess
import sys

# Forbidden patterns matching blocked files or directories
BLOCKED_PATTERNS = [
    r"(^|/)\.osc(/|$)",
    r"\.(?:obsinfo|obscpio)$",
]

ZERO_COMMIT = "0000000000000000000000000000000000000000"


def get_changed_files(oldrev: str, newrev: str) -> list[str]:
    """Retrieve all changed or added files within the pushed commit range."""
    if newrev == ZERO_COMMIT:
        return []  # Branch deleted

    if oldrev == ZERO_COMMIT:
        # New branch: Compare against all other existing branches
        cmd = [
            "git",
            "log",
            newrev,
            "--name-only",
            "--pretty=format:",
            "--not",
            "--all",
            "--not",
            newrev,
        ]
    else:
        # Existing branch: Normal diff range
        cmd = [
            "git",
            "log",
            f"{oldrev}..{newrev}",
            "--name-only",
            "--pretty=format:",
        ]

    try:
        result = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=True,
        )
        # Filter out empty lines and remove duplicates using a set
        files = {
            line.strip()
            for line in result.stdout.splitlines()
            if line.strip()
        }
        return list(files)
    except subprocess.CalledProcessError:
        return []


def main() -> None:
    """Read pushed refs from stdin and reject forbidden file patterns."""
    exit_code = 0
    compiled_patterns = [re.compile(p) for p in BLOCKED_PATTERNS]

    # Git passes old ref, new ref, and branch name via standard input
    for line in sys.stdin:
        parts = line.strip().split()
        if len(parts) < 3:
            continue
        oldrev, newrev, _refname = parts[0], parts[1], parts[2]

        changed_files = get_changed_files(oldrev, newrev)
        for file_path in changed_files:
            for pattern in compiled_patterns:
                if pattern.search(file_path):
                    # Print to stderr for immediate developer feedback
                    print(
                        f"[PUSH REJECTED] The file '{file_path}' matches "
                        f"blocked pattern: {pattern.pattern}",
                        file=sys.stderr,
                    )
                    exit_code = 1

    sys.exit(exit_code)


if __name__ == "__main__":
    main()
