info:
  summary: Create a devel/ci VM for YaPOC
  description: |+
               # Here you can add a description of your KankuFile
               # Please describe its purpose and what it's doing.
               #
               # Enjoy YLWK!
domain_name: yapoc
default_job: tasks
login_user: root
login_pass: kankudai

jobs:
 tasks:
  -
    use_module: Kanku::Handler::OBSCheck
    options:
      obsurl: https://api.opensuse.org/public
      # Please have a look at
      # kanku lsi
      # to find more official Images
      project: devel:kanku:images
      package: openSUSE-Tumbleweed-JeOS:ext4
      repository: images_tumbleweed
  -
    use_module: Kanku::Handler::ImageDownload
  -
    use_module: Kanku::Handler::CreateDomain
    options:
      memory: 2G
      vcpu: 2
      use_9p: 1
  -
    use_module: Kanku::Handler::PrepareSSH
  # Kanku::Handler::CopyProfile configuration in kanku-config.yml required
  -
    use_module: Kanku::Handler::CopyProfile
  -
    use_module: Kanku::Handler::ExecuteCommandViaSSH
    descripition: Install software and setup test environment
    options:
      commands:
        - zypper ref -s
        - zypper -n dup
        - zypper -n install make git-core git-lfs vim python3
        - zypper -n install python313-GitPython python313-pygit2
        - git -C /etc/ init
        - git -C /etc/ add .
        - git -C /etc/ commit -m "initial commit"
        - sh -x /tmp/kanku/setup-env.sh  > /tmp/setup.sh.log 2>&1
  -
    use_module: Kanku::Handler::ExecuteCommandViaSSH
    options:
      username: kanku
      commands:
        - test -d /tmp/kanku/log/ || mkdir /tmp/kanku/log/
        - cd /tmp/kanku/git-hooks && rm -f pre-receive && ln -s pre-receive-subprocess pre-receive
        - make -C /tmp/kanku/ test >> /tmp/kanku/log/test.log 2>&1
        - rm -rf git; mkdir git
        - cd /tmp/kanku/git-hooks && rm -f pre-receive && ln -s pre-receive-pygit2 pre-receive
        - make -C /tmp/kanku/ test > /tmp/kanku/log/test.log 2>&1
        - rm -rf git; mkdir git
        - sh -x /tmp/kanku/test.sh >> /tmp/kanku/log/test.log 2>&1


job_groups:
  all:
    - tasks

notifiers:
  tasks:
    -
      use_module: Kanku::Notifier::Console
      options:
        template: |+
          [% USE Filter::ANSIColor 'color' %]
          ****
          **** Your text for [% context.ipaddress | color 'red' %] goes here
          ****
      states: succeed

